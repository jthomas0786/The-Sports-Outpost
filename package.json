{
  "name": "dinger-watch-slate-builder",
  "version": "1.0.0",
  "type": "module",
  "description": "The Sports Outpost slate builders and automatic NFL simulation engine",
  "scripts": {
    "build": "node build-slate.js",
    "build:tomorrow": "node -e \"const d=new Date();d.setDate(d.getDate()+1);console.log(d.toISOString().slice(0,10))\" | xargs -I{} node build-slate.js --date {}",
    "nfl:sim": "node scripts/nfl-simulate.mjs",
    "nfl:sim:test": "node scripts/nfl-sim-selftest.mjs && node scripts/nfl-sim-auto-selftest.mjs",
    "nfl:sim:auto": "node scripts/nfl-sim-auto.mjs",
    "nfl:sim:auto:test": "node scripts/nfl-sim-auto-selftest.mjs",
    "nfl:halftime:odds": "node scripts/nfl-halftime-odds-refresh.mjs",
    "nfl:v87:test": "node scripts/nfl-v87-selftest.mjs && npm run nfl:sim:test",
    "nfl:v88:test": "node scripts/nfl-v88-selftest.mjs && npm run nfl:v87:test",
    "nfl:v881:test": "node scripts/nfl-v881-selftest.mjs && npm run nfl:v88:test",
    "nfl:v88.2:test": "node scripts/nfl-v882-selftest.mjs",
    "nfl:v88.3:test": "node scripts/nfl-v883-selftest.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
